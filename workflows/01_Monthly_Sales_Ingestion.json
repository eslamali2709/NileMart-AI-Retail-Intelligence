    {
      "parameters": {
        "jsCode": "// Prevent uploads when the duplicate lookup fails.\nconst lookupErrors = $('Check Existing Reports').all(1);\n\nif (lookupErrors.length > 0) {\n  return [];\n}\nconst validated = $('Validate Report Upload').first();\n\nconst branch = String(\n  validated.json.branch || ''\n).trim().toLowerCase();\n\nconst reportMonth = String(\n  validated.json.report_month || ''\n).trim();\n\nconst existingRows = $input.all();\n\n// Check whether a matching branch-month report exists\nconst isDuplicate = existingRows.some(item => {\n  const row = item.json || {};\n\n  return (\n    String(row.branch || '').trim().toLowerCase() === branch &&\n    String(row.report_month || '').trim() === reportMonth\n  );\n});\n\n// Existing report: reject without passing the PDF forward\nif (isDuplicate) {\n  return [{\n    json: {\n      success: false,\n      is_duplicate: true,\n      branch: validated.json.branch,\n      report_month: reportMonth,\n      error_code: \"DUPLICATE_REPORT\",\n      message: \"A report already exists for this branch and month.\"\n    },\n    pairedItem: { item: 0 }\n  }];\n}\n\n// New report: preserve the validated metadata and PDF\nreturn [{\n  json: {\n    ...validated.json,\n    is_duplicate: false\n  },\n  binary: validated.binary,\n  pairedItem: { item: 0 }\n}];\n"
      },
