    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\nconst body = item.json.body || {};\nconst file = item.binary?.file;\n\nconst allowedBranches = [\n  \"Cairo\",\n  \"Alexandria\",\n  \"Mansoura\",\n  \"Giza\"\n];\n\nfunction reject(errorCode, message) {\n  return [{\n    json: {\n      success: false,\n      validation_status: \"rejected\",\n      error_code: errorCode,\n      message: message\n    },\n    pairedItem: { item: 0 }\n  }];\n}\n\nconst branch = String(body.branch || \"\").trim();\nconst reportMonth = String(body.report_month || \"\").trim();\n\nif (!allowedBranches.includes(branch)) {\n  return reject(\n    \"INVALID_BRANCH\",\n    \"Branch is missing or invalid.\"\n  );\n}\n\nif (!/^\\d{4}-(0[1-9]|1[0-2])$/.test(reportMonth)) {\n  return reject(\n    \"INVALID_REPORT_MONTH\",\n    \"Report month must be in YYYY-MM format.\"\n  );\n}\n\nif (!file) {\n  return reject(\n    \"MISSING_FILE\",\n    \"A PDF file is required.\"\n  );\n}\n\nconst fileName = String(file.fileName || \"\");\n\nif (\n  file.mimeType !== \"application/pdf\" ||\n  !fileName.toLowerCase().endsWith(\".pdf\")\n) {\n  return reject(\n    \"INVALID_FILE_TYPE\",\n    \"Only PDF files are accepted.\"\n  );\n}\n\n// Check actual file signature, not only its extension.\nlet fileBuffer;\n\ntry {\n  fileBuffer = await this.helpers.getBinaryDataBuffer(0, \"file\");\n} catch (error) {\n  return reject(\n    \"UNREADABLE_FILE\",\n    \"The uploaded file could not be read.\"\n  );\n}\n\nif (\n  !fileBuffer ||\n  fileBuffer.length < 5 ||\n  fileBuffer.subarray(0, 5).toString(\"ascii\") !== \"%PDF-\"\n) {\n  return reject(\n    \"INVALID_PDF\",\n    \"The uploaded file is not a valid PDF.\"\n  );\n}\n\nreturn [{\n  json: {\n    branch,\n    report_month: reportMonth,\n    file_name: fileName,\n    mime_type: file.mimeType,\n    uploaded_at: new Date().toISOString(),\n    validation_status: \"passed\"\n  },\n  binary: { file },\n  pairedItem: { item: 0 }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
