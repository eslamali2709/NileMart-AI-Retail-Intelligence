        "jsCode": "const doc = $input.first().json;\nreturn [{json: {\n  status: 'skipped_already_indexed',\n  reason: 'Supabase documents already contains a chunk for this Drive file_id',\n  file_id: doc.file_id,\n  file_name: doc.file_name,\n  branch: doc.branch,\n  report_month: doc.report_month,\n}}];"
      },
