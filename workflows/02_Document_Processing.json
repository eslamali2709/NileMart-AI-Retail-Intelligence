    },
    {
      "parameters": {
        "jsCode": "const doc = $('Prepare Document Metadata').first().json;\nconst rows = $input.all().map((item) => item.json || {});\nconst alreadyIndexed = rows.some((row) => row.id !== undefined && row.id !== null);\nreturn [{ json: {\n  ...doc,\n  should_index: !alreadyIndexed,\n  indexing_decision: alreadyIndexed ? 'skip_existing_file_id' : 'index_new_file_id',\n}}];"
      },
