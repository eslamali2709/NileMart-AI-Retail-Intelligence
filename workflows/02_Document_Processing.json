    {
      "parameters": {
        "jsCode": "// Use the actual item sent down the False branch, not a potentially stale trigger reference.\nconst file = $input.first()?.json || {};\nreturn [{json: {\n  status: 'skipped_non_pdf',\n  reason: 'Drive file must have application/pdf MIME type AND .pdf extension',\n  file_id: file.id || null,\n  file_name: file.name || null,\n  mime_type: file.mimeType || null,\n}}];"
      },
