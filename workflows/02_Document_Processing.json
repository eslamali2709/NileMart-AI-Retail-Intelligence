      "id": "593f453c-ce5f-420a-a755-ba5c4226a7d1",
      "name": "Lookup Report in Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -1296,
        64
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "A successful lookup with zero matching rows emits one empty item for metadata fallback. API failures STOP the entire workflow after retries; never treat a Sheets error as a missing row."
    },
    {
      "parameters": {
        "jsCode": "// Workflow 2: normalize PDF and metadata from Google Drive, Sheets, or the filename.\nconst sheetRow = $input.first()?.json || {};\nconst drive = $('Google Drive Trigger').first().json;\nconst extraction = $('Extract PDF Text').first().json;\n\nconst fileId = String(drive.id || '').trim();\nconst fileName = String(drive.name || '').trim();\nconst mimeType = String(drive.mimeType || '').trim().toLowerCase();\nconst text = String(extraction.text || '').replace(/\\u0000/g, '').replace(/\\r\\n/g, '\\n').trim();\n\nif (!/^[A-Za-z0-9_-]{10,200}$/.test(fileId)) {\n  throw new Error('Invalid or missing Google Drive file ID; indexing stopped.');\n}\nif (mimeType !== 'application/pdf' || !/\\.pdf$/i.test(fileName)) {\n  throw new Error('The selected Drive file is not a valid PDF by MIME type and extension: ' + fileName);\n}\nif (text.length < 80) {\n  throw new Error('PDF text extraction produced fewer than 80 characters. Scanned/image-only PDFs require OCR. File: ' + fileName);\n}\n\nconst branchCodes = { CAI: 'Cairo', ALX: 'Alexandria', GIZ: 'Giza', MAN: 'Mansoura' };\nconst allowedBranches = Object.values(branchCodes);\nconst metadataText = [fileName, text.slice(0, 1000)].join('\\n');\nconst reportCode = metadataText.match(/(?:NM-|NileMart[_ -])?(CAI|ALX|GIZ|MAN)[_-](20\\d{2}-(?:0[1-9]|1[0-2]))/i);\nconst sheetBranch = String(sheetRow.branch || '').trim();\nconst sheetMonth = String(sheetRow.report_month || '').trim();\nconst validSheetBranch = allowedBranches.find((b) => b.toLowerCase() === sheetBranch.toLowerCase()) || '';\nconst validSheetMonth = /^20\\d{2}-(0[1-9]|1[0-2])$/.test(sheetMonth) ? sheetMonth : '';\n\nconst branchFromText = text.slice(0, 1000).match(/\\bBranch\\s*:\\s*(Cairo|Alexandria|Giza|Mansoura)\\b/i);\nconst branch = validSheetBranch || (reportCode ? branchCodes[reportCode[1].toUpperCase()] : '')\n  || (branchFromText ? allowedBranches.find((b) => b.toLowerCase() === branchFromText[1].toLowerCase()) : '');\nconst monthFromText = metadataText.match(/\\b(20\\d{2}-(?:0[1-9]|1[0-2]))\\b/);\nconst reportMonth = validSheetMonth || (reportCode?.[2] || monthFromText?.[1] || '');\n\nif (!branch || !reportMonth) {\n  throw new Error('Cannot determine branch and report month. Check the Reports sheet or rename the PDF, e.g. NileMart_CAI_2026-09_Sales_Inventory.pdf.');\n}\n\nconst fromSheets = Boolean(validSheetBranch && validSheetMonth);\nconst sheetLink = String(sheetRow.file_link || '').trim();\nconst driveLink = sheetLink || ('https://drive.google.com/file/d/' + encodeURIComponent(fileId) + '/view');\nconst indexedAt = new Date().toISOString();\n\nreturn [{json: {\n  file_id: fileId,\n  file_name: fileName,\n  branch,\n  report_month: reportMonth,\n  drive_url: driveLink,\n  page_count: Number(extraction.numpages || 0),\n  indexed_at: indexedAt,\n  metadata_source: fromSheets ? 'google_sheets' : 'pdf_or_filename',\n  document_text: [\n    'NileMart Monthly Sales and Inventory Report',\n    'Branch: ' + branch,\n    'Report month: ' + reportMonth,\n    'Original PDF: ' + fileName,\n    '',\n    text,\n  ].join('\\n'),\n}}];"
      },
