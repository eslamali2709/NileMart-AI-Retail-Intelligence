# Server-only settings for your own local demonstration. Never use NEXT_PUBLIC_.
# Leave URLs empty until your own workflow copies and resources are configured.
# HTTPS required, except HTTP on localhost/127.0.0.1/[::1].
# Path must be /webhook/monthly-sales-upload or /webhook-test/monthly-sales-upload.
# Development-only exception: HTTP loopback port 5678 with the exact test path
# /webhook-test/monthly-sales-e2e-sandbox-test. Use npm run dev, not npm start.
# NODE_ENV is managed by Next.js; do not override it in environment files.
# Example production path on local n8n: http://localhost:5678/webhook/monthly-sales-upload
# No credentials, query strings, or fragments in this URL.
N8N_UPLOAD_WEBHOOK_URL=

# Exact browser origin; do not mix localhost and 127.0.0.1. No trailing path.
APP_ORIGIN=http://localhost:3000

# PDF limit in bytes: 10 MiB (10 * 1024 * 1024), maximum supported 100 MiB.
UPLOAD_MAX_BYTES=10485760

# Total upstream confirmation deadline, including response reading (max 120000).
UPLOAD_TIMEOUT_MS=30000

# Workflow 03B Chat Trigger settings, used only by the server.
# Use your imported workflow's production Chat URL; its identifier is generated by n8n.
# HTTP is allowed only on loopback. Supply your own HTTP Basic Auth credential.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_USERNAME=
N8N_CHAT_PASSWORD=

# Workflow 04A Reports Catalog API. Supply your own HTTP Basic Auth credential.
# Production path: /webhook/nilemart-reports-catalog-v1. HTTP only on loopback.
N8N_REPORTS_WEBHOOK_URL=http://localhost:5678/webhook/nilemart-reports-catalog-v1
N8N_REPORTS_USERNAME=
N8N_REPORTS_PASSWORD=
